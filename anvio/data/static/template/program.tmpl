<dd class="parameter-details{% if parameter.required %} parameter-required{% endif %}"><span class="parameter-help">{{ parameter.help }}</span>{% if parameter.choices %} <span class="parameter-choices"><span class="parameter-label">Choices:</span> {% for choice in parameter.choices %}<code class="parameter-choice">{{ choice }}</code>{% if not forloop.last %} {% endif %}{% endfor %}</span>{% endif %}{% if parameter.takes_value and parameter.default is not None %} <span class="parameter-default"><span class="parameter-label">Default:</span> <code class="parameter-default-value">{{ parameter.default }}</code></span>{% endif %}</dd>{% endfor %}
</dl>
</section>{% endfor %}
</div>
